pipeline {
    agent any

    parameters {
        string(
            name: 'TARGET_IP',
            defaultValue: '',
            description: 'IP address of the existing DigitalOcean droplet to configure'
        )
        string(
            name: 'SERVER_NAME',
            defaultValue: '',
            description: 'Droplet name, forwarded through to Register-Grafana-Target as the target servername'
        )
        string(
            name: 'PROJECT_NAME',
            defaultValue: '',
            description: 'DigitalOcean project name, forwarded through to Register-Grafana-Target to resolve the target file/group'
        )
    }

    environment {
        NEW_SERVER_IP = "${params.TARGET_IP}"
        ANSIBLE_USER   = 'ansible'
        BOOTSTRAP_USER = 'root'
        NODE_EXPORTER_VERSION = '1.12.1'
    }

    options {
        timestamps()
    }

    stages {

        stage('Validate Server IP') {
            steps {
                echo "===================================================="
                echo "STAGE: Validate Server IP"
                echo "===================================================="
                script {
                    if (!env.NEW_SERVER_IP?.trim()) {
                        error("TARGET_IP is empty or null — aborting before wasting the SSH-wait timeout")
                    }
                    if (!(env.NEW_SERVER_IP ==~ /^(\d{1,3}\.){3}\d{1,3}$/)) {
                        error("TARGET_IP '${env.NEW_SERVER_IP}' does not look like a valid IPv4 address")
                    }
                    echo "Validated target IP: ${env.NEW_SERVER_IP}"
                }
            }
        }

        stage('Wait for SSH') {
            steps {
                echo "===================================================="
                echo "STAGE: Wait for SSH"
                echo "===================================================="
                withCredentials([sshUserPrivateKey(
                    credentialsId: 'deploy-ssh-key',
                    keyFileVariable: 'DEPLOY_KEY',
                    usernameVariable: 'DEPLOY_KEY_USER'
                )]) {
                    script {
                        def ready = false
                        for (int i = 1; i <= 30; i++) {
                            def portOpen = sh(
                                script: "nc -z -w5 ${env.NEW_SERVER_IP} 22",
                                returnStatus: true
                            ) == 0

                            if (portOpen) {
                                def sshOk = sh(
                                    script: """
                                        ssh -o StrictHostKeyChecking=no -o ConnectTimeout=10 \\
                                            -o BatchMode=yes \\
                                            -i ${DEPLOY_KEY} \\
                                            ${BOOTSTRAP_USER}@${env.NEW_SERVER_IP} 'echo ssh-ok'
                                    """,
                                    returnStatus: true
                                ) == 0
                                if (sshOk) {
                                    ready = true
                                    break
                                }
                            }
                            echo "SSH not ready (attempt ${i}/30), sleeping 10s..."
                            sleep(time: 10, unit: 'SECONDS')
                        }
                        if (!ready) {
                            error("SSH did not become ready on ${env.NEW_SERVER_IP} within 300s")
                        }
                        echo "SSH handshake successful on ${env.NEW_SERVER_IP}"
                    }
                }
            }
        }

        // ----------------------------------------------------------------
        // Create Ansible User
        //
        // Rewritten from the heredoc-as-ssh-argument approach. That
        // pattern breaks for any value containing spaces (an SSH public
        // key always does) because ssh joins every argument after
        // user@host into one string for the REMOTE shell to re-parse,
        // and it undoes local quoting. It also silently loses any
        // env var (like $ANSIBLE_USER) that isn't explicitly forwarded,
        // since ssh does not export the local shell's environment.
        //
        // Fix: resolve the public key locally, write the full remote
        // script to a local file with the value already substituted,
        // then stream that file to `bash -s` over stdin. No argument
        // joining, no remote-side variable dependency.
        // ----------------------------------------------------------------
        stage('Create Ansible User') {
            steps {
                echo "===================================================="
                echo "STAGE: Create Ansible User"
                echo "===================================================="
                withCredentials([sshUserPrivateKey(
                    credentialsId: 'deploy-ssh-key',
                    keyFileVariable: 'DEPLOY_KEY',
                    usernameVariable: 'DEPLOY_KEY_USER'
                )]) {
                    script {
                        def pubKey = sh(
                            script: "ssh-keygen -y -f ${DEPLOY_KEY}",
                            returnStdout: true
                        ).trim()

                        // Single-quoted Groovy string: NO interpolation,
                        // NO need to escape $ anywhere. Only __PUBKEY__
                        // gets substituted, via plain string replace.
                        def template = '''
set -euo pipefail

echo "---- [1/3] ansible user ----"
if id "ansible" &>/dev/null; then
    echo "User 'ansible' already exists — continuing"
else
    useradd -m -s /bin/bash "ansible"
    echo "User 'ansible' created"
fi

echo "---- [2/3] authorized_keys ----"
mkdir -p /home/ansible/.ssh
chmod 700 /home/ansible/.ssh
touch /home/ansible/.ssh/authorized_keys
if grep -qxF "__PUBKEY__" /home/ansible/.ssh/authorized_keys; then
    echo "Deploy public key already present — skipping"
else
    echo "__PUBKEY__" >> /home/ansible/.ssh/authorized_keys
    echo "Deploy public key added"
fi
chmod 600 /home/ansible/.ssh/authorized_keys
chown -R ansible:ansible /home/ansible/.ssh

echo "---- [3/3] restricted sudoers ----"
cat > /etc/sudoers.d/ansible <<'SUDOERS'
ansible ALL=(root) NOPASSWD: /bin/systemctl enable node_exporter
ansible ALL=(root) NOPASSWD: /bin/systemctl start node_exporter
ansible ALL=(root) NOPASSWD: /bin/systemctl restart node_exporter
ansible ALL=(root) NOPASSWD: /bin/systemctl stop node_exporter
ansible ALL=(root) NOPASSWD: /bin/systemctl status node_exporter
ansible ALL=(root) NOPASSWD: /bin/systemctl daemon-reload
ansible ALL=(root) NOPASSWD: /usr/bin/tee /etc/systemd/system/node_exporter.service
ansible ALL=(root) NOPASSWD: /bin/chown root\\:root /etc/systemd/system/node_exporter.service
ansible ALL=(root) NOPASSWD: /bin/chmod 644 /etc/systemd/system/node_exporter.service
ansible ALL=(root) NOPASSWD: /bin/mkdir -p /opt/node_exporter
ansible ALL=(root) NOPASSWD: /bin/cp /tmp/node_exporter-* /opt/node_exporter/
ansible ALL=(root) NOPASSWD: /bin/chown -R node_exporter\\:node_exporter /opt/node_exporter
ansible ALL=(root) NOPASSWD: /usr/sbin/useradd --system --no-create-home --shell /usr/sbin/nologin node_exporter
ansible ALL=(root) NOPASSWD: /bin/id node_exporter
ansible ALL=(root) NOPASSWD: /usr/bin/journalctl -u node_exporter *
SUDOERS
chmod 440 /etc/sudoers.d/ansible
visudo -cf /etc/sudoers.d/ansible

echo "Ansible user provisioning complete"
'''

                        writeFile file: 'ensure_ansible_user.sh', text: template.replace('__PUBKEY__', pubKey)

                        sh """
                            ssh -o StrictHostKeyChecking=no -o BatchMode=yes \\
                                -i ${DEPLOY_KEY} \\
                                ${BOOTSTRAP_USER}@${env.NEW_SERVER_IP} 'bash -s' < ensure_ansible_user.sh
                        """
                    }
                }
            }
        }

        // ----------------------------------------------------------------
        // Install Node Exporter
        //
        // Same writeFile + stdin pattern. Also fixes two sudoers
        // mismatches from the original: cp now uses the absolute
        // /tmp/... path the whitelist expects (the script had cd'd into
        // /tmp and used a relative path, which sudoers won't match),
        // and systemctl enable + start are issued as two separate sudo
        // calls to match the two separate whitelist entries, instead of
        // one combined `enable --now` that matches neither.
        // ----------------------------------------------------------------
        stage('Install Node Exporter') {
            steps {
                echo "===================================================="
                echo "STAGE: Install Node Exporter"
                echo "===================================================="
                withCredentials([sshUserPrivateKey(
                    credentialsId: 'deploy-ssh-key',
                    keyFileVariable: 'DEPLOY_KEY',
                    usernameVariable: 'DEPLOY_KEY_USER'
                )]) {
                    script {
                        def neVersion = env.NODE_EXPORTER_VERSION

                        def template = '''
set -euo pipefail

SUDO="sudo -n"

echo "---- [1/4] node_exporter system user ----"
if $SUDO id node_exporter &>/dev/null; then
    echo "node_exporter user already exists"
else
    $SUDO useradd --system --no-create-home --shell /usr/sbin/nologin node_exporter
    echo "node_exporter user created"
fi

echo "---- [2/4] binary ----"
if [ -x /opt/node_exporter/node_exporter ]; then
    INSTALLED=$(/opt/node_exporter/node_exporter --version 2>&1 | awk 'NR==1{print $3}')
    echo "node_exporter already installed: v${INSTALLED}"
else
    cd /tmp
    echo "Downloading node_exporter v__NE_VERSION__..."
    curl -fsSL -o ne.tar.gz \\
        "https://github.com/prometheus/node_exporter/releases/download/v__NE_VERSION__/node_exporter-__NE_VERSION__.linux-amd64.tar.gz"
    tar xzf ne.tar.gz
    $SUDO mkdir -p /opt/node_exporter
    $SUDO cp "/tmp/node_exporter-__NE_VERSION__.linux-amd64/node_exporter" /opt/node_exporter/
    rm -rf ne.tar.gz "node_exporter-__NE_VERSION__.linux-amd64"
    echo "node_exporter v__NE_VERSION__ installed to /opt/node_exporter/"
fi
$SUDO chown -R node_exporter:node_exporter /opt/node_exporter

echo "---- [3/4] systemd unit ----"
UNIT=/etc/systemd/system/node_exporter.service
if [ -f "$UNIT" ]; then
    echo "systemd unit already present"
else
    echo "Writing $UNIT"
    $SUDO tee "$UNIT" > /dev/null <<'UNIT_EOF'
[Unit]
Description=Prometheus Node Exporter
Wants=network-online.target
After=network-online.target

[Service]
User=node_exporter
Group=node_exporter
Type=simple
ExecStart=/opt/node_exporter/node_exporter --web.listen-address=:9100 --collector.filesystem.mount-points-exclude='^/(sys|proc|dev|run|var/lib/docker/.+)($|/)'
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
UNIT_EOF
    $SUDO chown root:root "$UNIT"
    $SUDO chmod 644 "$UNIT"
fi

echo "---- [4/4] enable + start ----"
$SUDO systemctl daemon-reload
$SUDO systemctl enable node_exporter
$SUDO systemctl start node_exporter
echo "node_exporter service enabled and started"
'''

                        writeFile file: 'install_node_exporter.sh', text: template.replace('__NE_VERSION__', neVersion)

                        sh """
                            ssh -o StrictHostKeyChecking=no -o BatchMode=yes \\
                                -i ${DEPLOY_KEY} \\
                                ${ANSIBLE_USER}@${env.NEW_SERVER_IP} 'bash -s' < install_node_exporter.sh
                        """
                    }
                }
            }
        }

        stage('Health Check') {
            steps {
                echo "===================================================="
                echo "STAGE: Health Check"
                echo "===================================================="
                withCredentials([sshUserPrivateKey(
                    credentialsId: 'deploy-ssh-key',
                    keyFileVariable: 'DEPLOY_KEY',
                    usernameVariable: 'DEPLOY_KEY_USER'
                )]) {
                    script {
                        def healthy = false
                        for (int i = 1; i <= 10; i++) {
                            def rc = sh(
                                script: """
                                    ssh -o StrictHostKeyChecking=no -o BatchMode=yes \\
                                        -i ${DEPLOY_KEY} \\
                                        ${ANSIBLE_USER}@${env.NEW_SERVER_IP} \\
                                        'curl -sf http://localhost:9100/metrics > /dev/null'
                                """,
                                returnStatus: true
                            ) == 0
                            if (rc) { healthy = true; break }
                            echo "Health check failed (attempt ${i}/10), retrying in 3s..."
                            sleep(time: 3, unit: 'SECONDS')
                        }
                        if (!healthy) {
                            error("node_exporter failed health check on ${env.NEW_SERVER_IP}:9100 after 10 attempts")
                        }
                        echo "node_exporter is serving metrics on :9100"
                    }
                }
            }
        }
    }

    post {
        success {
            echo "Server ${env.NEW_SERVER_IP} provisioned + monitored (node_exporter :9100)"
            build job: 'Digital-Ocean/AIL-Mix/Register-Grafana-Target',
                  parameters: [
                      string(name: 'TARGET_IP', value: env.NEW_SERVER_IP),
                      string(name: 'SERVER_NAME', value: params.SERVER_NAME),
                      string(name: 'PROJECT_NAME', value: params.PROJECT_NAME)
                  ],
                  wait: false
        }
        failure {
            script {
                if (env.NEW_SERVER_IP?.trim()) {
                    withCredentials([sshUserPrivateKey(
                        credentialsId: 'deploy-ssh-key',
                        keyFileVariable: 'DEPLOY_KEY',
                        usernameVariable: 'DEPLOY_KEY_USER'
                    )]) {
                        sh '''
                            echo "===== node_exporter journal (last 20 lines) on ${NEW_SERVER_IP} ====="
                            ssh -o StrictHostKeyChecking=no -o BatchMode=yes \\
                                -i $DEPLOY_KEY \\
                                ${ANSIBLE_USER}@${NEW_SERVER_IP} \\
                                'sudo -n journalctl -u node_exporter -n 20 --no-pager' \\
                                || echo "(could not fetch journal — server may not have reached node_exporter stage)"
                        '''
                    }
                } else {
                    echo "Failure occurred before server IP was known — nothing to diagnose on target."
                }
            }
        }
    }
}
